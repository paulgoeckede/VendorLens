{
    "name": "Seller Check for Amazon",
    "description": "An extension to check seller information on Amazon.",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "*://*.amazon.de/*"
    ],
    "action": {
        "default_popup": "./src/popup/hello.html",
        "default_icon": "./assets/icons/logo-128.png"
    },
    "content_scripts": [
        {
            "matches": ["*://*.amazon.de/*"],
            "js": ["./src/content/i18n_config.js", "./src/content/scanner.js"]
        }
    ],
    "background": {
        "service_worker": "./src/background/background.js"
    },
    "icons": {
        "16": "./assets/icons/logo-16.png",
        "32": "./assets/icons/logo-32.png",
        "34": "./assets/icons/logo-34.png",
        "48": "./assets/icons/logo-48.png",
        "128": "./assets/icons/logo-128.png"
    },
    "web_accessible_resources": [
        {
            "resources": ["assets/icons/*"],
            "matches": ["*://*.amazon.de/*", "*://*.amazon.com/*"]
        }
    ]
}